# Copy to .env.local and put real values there. This file is committed, so leave the values empty.

# Google AI Studio key for Gemini, the primary model (@ai-sdk/google reads this name by default)
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq key for gpt-oss-120b, the fallback model (@ai-sdk/groq reads this name by default)
GROQ_API_KEY=

# nfl-mcp Streamable HTTP endpoint ending in /mcp, local or on Render (our code reads it; no SDK default)
NFL_MCP_URL=
